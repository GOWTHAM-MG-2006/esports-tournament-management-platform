# Copy to `.env` for local development.
# Vite exposes variables prefixed with VITE_ to the frontend.
# Leave empty to use the dev-server proxy (same-origin `/api`).
VITE_API_URL=
# Direct backend origin for the "Open Django Admin" link.
# Needed only when VITE_API_URL is unset (dev proxy can't reveal the backend host).
# Local default if runserver runs on :8000:
# VITE_BACKEND_URL=http://localhost:8000
# Production example:
# VITE_BACKEND_URL=https://esports-api-nr3v.onrender.com
VITE_BACKEND_URL=
