# Copy to `.env` for local development. NEVER commit `.env` (it is gitignored).
# Defaults in config/settings.py work for local Postgres + console email.

# --- Email (Gmail SMTP, for real OTP delivery) ---
# Leave EMAIL_BACKEND unset (or console) to print mails to the backend
# terminal instead of sending. Set these to send for real via Gmail:
#   1. Enable 2-Step Verification on the Gmail account.
#   2. Generate an App Password at myaccount.google.com/apppasswords.
#   3. Fill EMAIL_HOST_USER with the Gmail address and
#      EMAIL_HOST_PASSWORD with the 16-letter app password (no spaces).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=paste-16-letter-app-password-here
DEFAULT_FROM_EMAIL=you@gmail.com

# --- Production deployment (server.env on the host, NEVER committed) ---
# SECRET_KEY: long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`
# DEBUG: always False in production.
# DATABASE_URL: Postgres connection, e.g. postgres://esports:STRONG-PASSWORD@db:5432/esports_db
# ALLOWED_HOSTS: public IP/DNS of the server, comma-separated.
# DB_PASSWORD: must match the password inside DATABASE_URL (used by the db service).
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
DATABASE_URL=postgres://esports:STRONG-PASSWORD@db:5432/esports_db
ALLOWED_HOSTS=your-server-ip
DB_PASSWORD=STRONG-PASSWORD
